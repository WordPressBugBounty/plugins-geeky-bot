msgstr "Las acciones de compra están desactivadas"

msgid "Storefront Pro buttons are not loaded."
msgstr "Los botones de Storefront Pro no están cargados."

msgid "Cart, comparison, coupon, lead and order endpoints require license authorization."
msgstr "Los puntos finales de carrito, comparación, cupón, clientes potenciales y pedidos requieren autorización de licencia."

msgid "Free product discovery still works in Geeky Bot core."
msgstr "El descubrimiento gratuito de productos sigue funcionando en el núcleo de Geeky Bot."

msgid "Why this is locked"
msgstr "Por qué está bloqueado"

msgid "Commerce Pro requires a site entitlement"
msgstr "Commerce Pro requiere autorización para este sitio"

msgid "A copied add-on folder cannot run Pro buying actions without an active license for this site."
msgstr "Una carpeta copiada del complemento no puede ejecutar acciones de compra Pro sin una licencia activa para este sitio."

