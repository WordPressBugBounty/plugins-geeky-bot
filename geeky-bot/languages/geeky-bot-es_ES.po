msgstr "No hay ninguna clave de Commerce Pro guardada todavía."

msgid "License deactivated on this site."
msgstr "Licencia desactivada en este sitio."

msgid "A valid Commerce Pro license with download access is required before installing the add-on."
msgstr "Se necesita una licencia con privilegios de descarga antes de incorporar la extensión."

msgid "The license server did not return a safe Commerce Pro package URL."
msgstr "El servidor de licencias no devolvió una URL segura para descargar Commerce Pro."

msgid "Commerce Pro could not be installed."
msgstr "No se pudo completar la instalación de Commerce Pro."

msgid "Activate a valid Commerce Pro license before activating the add-on."
msgstr "Activa una licencia legítima de Commerce Pro antes de encender la extensión."

msgid "You do not have permission to update plugins."
msgstr "Careces de permisos para actualizar plugins."

msgid "Your Commerce Pro license must include update access before updating the add-on."
msgstr "Tu licencia debe contemplar acceso a actualizaciones para poner al día la extensión."

msgid "Commerce Pro is already on the latest available version."
msgstr "Commerce Pro ya se encuentra en la versión más actual."

msgid "The license server did not return a valid Commerce Pro update package."
msgstr "El servidor no facilitó un paquete legítimo de actualización para Commerce Pro."

msgid "Commerce Pro could not be updated."
msgstr "No se pudo actualizar Commerce Pro."

msgid "The Commerce Pro update package could not be downloaded."
msgstr "No fue posible descargar el paquete de actualización de Commerce Pro."

msgid "The Commerce Pro update package is empty or incomplete."
msgstr "El archivo comprimido de actualización está vacío o incompleto."

msgid "The Commerce Pro update package is invalid. Please try again or contact Geeky Bot support."
msgstr "El paquete de actualización es defectuoso. Inténtalo de nuevo o contacta con el soporte de Geeky Bot."

msgid "The downloaded Commerce Pro package is not a valid ZIP archive."
msgstr "El paquete descargado de Commerce Pro no es un archivo ZIP válido."

msgid "The downloaded Commerce Pro package did not match the release checksum."
msgstr "El archivo descargado no coincide con la suma de control (checksum) original."

msgid "Important Commerce Pro security update %1$s is available. Installed version: %2$s."
msgstr "Importante actualización de seguridad %1$s disponible para Commerce Pro. Versión instalada: %2$s."

msgid "Commerce Pro %1$s is available. Installed version: %2$s."
msgstr "Commerce Pro %1$s disponible. Versión instalada: %2$s."

