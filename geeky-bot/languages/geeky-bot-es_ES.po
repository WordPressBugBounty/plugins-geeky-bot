msgstr "Respuestas multilingües"

msgid "Needs Zywrap or OpenAI. Local mode does not generate text."
msgstr "Requiere Zywrap u OpenAI. El modo local no genera texto libre."

msgid "Local mode never generates free text, so nothing needs constraining."
msgstr "El modo local nunca genera texto libre, por lo que no requiere restricciones."

msgid "Public coupon codes added"
msgstr "Códigos de cupón públicos añadidos"

msgid "The switch is on; add codes for it to have anything to offer."
msgstr "La opción está activada; añade códigos para que tenga algo que ofrecer."

msgid "Sales rules written"
msgstr "Reglas de venta redactadas"

msgid "The switch is on; write a rule for it to have anything to say."
msgstr "La opción está activada; redacta una regla para que tenga algo que comunicar."

msgid "Activate Commerce Pro on this site"
msgstr "Activar Commerce Pro en este sitio"

msgid "The add-on is installed, but buying actions stay disabled until Geeky Bot confirms a valid license for this site."
msgstr "El complemento está instalado, pero las acciones de compra permanecen desactivadas hasta que Geeky Bot confirme una licencia válida para este sitio."

