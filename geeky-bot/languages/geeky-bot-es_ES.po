msgstr[0] "Solo hay %1$d resultado, de modo que no hay un %2$s producto para comparar. Busca más artículos o indica ambos nombres."
msgstr[1] "Solo se muestran %1$d resultados, de modo que no hay un %2$s producto para comparar. Busca más artículos o indica ambos nombres."

msgid "first"
msgstr "primero"

msgid "second"
msgstr "segundo"

msgid "third"
msgstr "tercero"

msgid "fourth"
msgstr "cuarto"

msgid "fifth"
msgstr "quinto"

msgid "sixth"
msgstr "sexto"

msgid "seventh"
msgstr "séptimo"

msgid "eighth"
msgstr "octavo"

msgid "ninth"
msgstr "noveno"

msgid "tenth"
msgstr "décimo"

msgid "#%d"
msgstr "#%d"

msgid "I couldn't find two visible store products matching those names."
msgstr "No localizo dos productos públicos que encajen con esas denominaciones."

msgid "that product"
msgstr "ese producto"

msgid "I found more than one visible product for “%1$s”: %2$s and %3$s. Please use the full product name."
msgstr "Existe más de un resultado visible para «%1$s»: %2$s y %3$s. Usa el nombre íntegro."

msgid "I couldn't find a visible store product matching “%s”."
msgstr "No di con ningún producto disponible en catálogo con el término «%s»."

msgid "I couldn't find another confirmed color for %s that also matches your remaining filters."
msgstr "No he hallado otro color verificado en %s que satisfaga tus otros filtros."

msgid "I couldn't find a close alternative to %s that also matches your remaining filters."
msgstr "No encuentro un sustituto similar para %s que cumpla las condiciones marcadas."

msgid "There isn't an earlier product list to restore in this conversation."
msgstr "No constan listas previas de productos que recuperar en esta charla."

msgid "I couldn't find products matching that change."
msgstr "No encontré artículos que se ajusten a esa variación."

msgid "I couldn't find this information in the store’s published policies. Please contact the store for confirmation."
msgstr "Ese dato no consta en las políticas publicadas. Consulta directamente al comercio para validarlo."

msgid "Here is %s."
msgstr "Aquí tienes %s."

msgid "From the products shown, %s is the closest match to your request. Open it to review the price, stock, and available options."
msgstr "Entre los artículos presentes, %s es el que mejor se ajusta. Pulsa en él para consultar tarifa, existencias y acabados."

msgid "%1$s has the largest confirmed discount among the products shown at about %2$d%% off. Open it to review the price, stock, and available options."
msgstr "%1$s ostenta la mayor rebaja confirmada entre los mostrados, con cerca de un %2$d%%. Accede para revisar detalles y opciones."

msgid "%s is the best discounted option I could confirm from the products shown."
msgstr "%s constituye la opción en oferta más idónea verificada de la lista."

msgid "You selected %s. Open it to review the price, stock, and available options."
msgstr "Elegiste %s. Ábrelo si deseas inspeccionar su precio, existencias y alternativas."

msgid "%1$s is available in these colors: %2$s. Open the product to choose an available option."
msgstr "%1$s se comercializa en estos colores: %2$s. Entra en el producto para escoger tu preferencia."

msgid "I couldn't find another confirmed color for that product."
msgstr "No me consta ningún otro color registrado para ese modelo."

msgid "the selected product"
msgstr "el producto seleccionado"

msgid "Here are some related alternatives to %s."
msgstr "Te presento varias opciones afines a %s."

msgid "I restored the previous product options."
msgstr "He recuperado las alternativas que teníamos antes."

msgid "I removed those filters and updated the results."
msgstr "He retirado esos filtros y actualizado los resultados."

msgid "I removed that filter and updated the results."
msgstr "He eliminado ese filtro y recalculado las opciones."

msgid "Here are some lower-priced options that still match your request."
msgstr "Aquí tienes opciones más económicas que encajan con tu búsqueda."

msgid "I narrowed the results using your latest preference."
msgstr "He acotado la lista atendiendo a tu último comentario."

msgid "Here are some more premium options that still match your request."
msgstr "Estas son algunas opciones de gama superior acordes a lo que buscas."

msgid "I couldn't find %1$s %2$s. Here are other products in that price range."
msgstr "No he hallado %1$s %2$s. Te dejo otras propuestas en esa franja de precio."

msgid "I couldn't find %s at that price. Here are other products that may fit your budget."
msgstr "No di con %s en esa cifra. Estos otros artículos podrían ajustarse a tu límite."

msgid "I couldn't find anything for \"%1$s\", so I searched for \"%2$s\" instead. Here is what I found."
msgstr "Sin resultados para «%1$s»; he buscado en su lugar «%2$s». Mira lo que he localizado."

msgid "Here are the closest matches I could find."
msgstr "Estas son las opciones más parecidas que he logrado encontrar."

msgid "I couldn't find an exact match %s. Here are the closest available products."
msgstr "No hay coincidencia exacta para %s. Te muestro lo más semejante del catálogo."

msgid "I couldn't find %1$s. Here are other %2$s options that may help."
msgstr "No encontré %1$s. Mira estas otras sugerencias de %2$s."

msgid "Here is %d product that matches your request."
msgid_plural "Here are %d products that match your request."
msgstr[0] "Aquí tienes %d producto acorde a tu solicitud."
msgstr[1] "Aquí tienes %d productos acordes a tu solicitud."

msgid "Top matches: %s."
msgstr "Mejores alternativas: %s."

msgid "I marked any requested details that the store has not confirmed."
msgstr "He señalado los aspectos solicitados que la tienda no tiene confirmados de forma oficial."

msgid "Open a product to review its price, stock, and available options."
msgstr "Pulsa sobre un producto para verificar importe, unidades disponibles y variantes."

msgid "I couldn't find a matching product. Try a different color, size, price, or product name."
msgstr "No he hallado ningún producto coincidente. Modifica el tono, talla, presupuesto o término buscado."

msgid "The store hasn't provided enough information for me to answer that."
msgstr "El comercio no aporta datos suficientes para clarificar ese punto."

msgid "I can't add items to your cart from here. You can add it from the product page and carry on shopping."
msgstr "No tengo habilitada la función de compra directa en chat. Puedes sumarlo desde su ficha y continuar con normalidad."

msgid "I can't change your cart from here. You can remove it on the cart page."
msgstr "No puedo alterar tu carrito desde este canal. Puedes prescindir de él en la página del carrito."

msgid "I can't change quantities from here. You can update the amount on the cart page."
msgstr "No me es posible variar unidades desde el diálogo. Puedes graduarlas dentro de la cesta."

msgid "I can't show your cart from here. The cart page has everything currently in it."
msgstr "No puedo mostrarte el carrito aquí. Podrás revisarlo al completo accediendo a la página del carrito."

msgid "I can't take you through checkout. You can review your cart and check out as usual."
msgstr "No realizo el cobro directamente. Revisa tus artículos y formaliza el pago por el circuito tradicional."

msgid "I don't have discount codes to give out. Any current offers will be shown on the product or cart pages."
msgstr "No gestiono cupones promocionales desde aquí. Toda rebaja vigente figurará en el carrito o en las fichas de producto."

msgid "I can't pass you to a person from here, and I'd rather say so than guess. The store's contact details are on its help pages."
msgstr "No tengo vía para transferirte a un agente, y prefiero ser transparente. Los teléfonos y canales de soporte constan en las páginas de ayuda."

msgid "I understood that, but I can't carry it out from here."
msgstr "Comprendo lo que precisas, pero no dispongo de permisos para ejecutarlo en este chat."

msgid "No matching product"
msgstr "Ningún artículo coincidente"

msgid "Review product titles, categories, attributes, stock, price, and common synonyms."
msgstr "Revisa nombres, categorías, atributos, existencias, precios y sinónimos habituales."

msgid "Product detail missing"
msgstr "Falta un dato del producto"

msgid "Add the missing fact to the WooCommerce product description or attributes."
msgstr "Incorpora la característica que falta en la descripción o atributos del producto en WooCommerce."

msgid "Product reference unclear"
msgstr "Alusión al producto ambigua"

msgid "Retest the selection flow and ensure product names are distinctive."
msgstr "Comprueba el proceso de selección y cerciórate de que las denominaciones sean inequívocas."

msgid "Policy source missing"
msgstr "Falta la fuente de políticas"

msgid "Select a published page for this policy area in Store Knowledge."
msgstr "Elige una página publicada para esta normativa dentro de Conocimiento de la tienda."

msgid "Policy detail missing"
msgstr "Falta el detalle de la política"

msgid "Add a clear answer to the selected policy page and refresh the knowledge index."
msgstr "Añade una respuesta tajante en la página informativa elegida y refresca el índice de conocimiento."

msgid "No grounded answer"
msgstr "Sin respuesta fundamentada"

msgid "Check whether the phrase belongs to products, policy content, or a Commerce Pro action."
msgstr "Determina si la frase alude a artículos, cláusulas normativas o a una función de Commerce Pro."

msgid "Review the shopper phrase and improve the matching store data."
msgstr "Examina la expresión del cliente y enriquece la información equivalente de la tienda."

msgid "show me %s"
msgstr "enséñame %s"

msgid "Conversation memory"
msgstr "Memoria contextual"

msgid "Ask a follow-up that names no product"
msgstr "Haz una pregunta sucesiva sin volver a nombrar el artículo"

msgid "which one is cheaper?"
msgstr "¿cuál de ellos es más barato?"

msgid "The second question names nothing. It is answered against the results already on screen."
msgstr "La segunda cuestión no menciona marcas ni nombres: se resuelve directamente sobre lo que se exhibe en pantalla."

msgid "Comparison"
msgstr "Comparación"

msgid "Compare by position, not by name"
msgstr "Comparar por posición en pantalla, no por nombre"

msgid "compare the first and second"
msgstr "compara el primero y el segundo"

msgid "Shoppers point at what they can see instead of retyping two product names."
msgstr "Los clientes señalan elementos visuales en lugar de teclear laboriosamente dos nombres largos."

msgid "Ask a detail across the whole result set"
msgstr "Consulta una propiedad de todos los resultados juntos"

msgid "what material are they?"
msgstr "¿de qué material son?"

msgid "Answered from stored product data for every result at once, naming any product the catalog does not record it for."
msgstr "Se aclara consultando los datos de cada modelo en pantalla al unísono, advirtiendo si de alguno no consta registro."

msgid "Refinement"
msgstr "Afinamiento"

msgid "Narrow the results without starting over"
msgstr "Filtrar resultados sin reiniciar la búsqueda"

msgid "only under %1$s%2$s"
msgstr "solo por menos de %1$s%2$s"

msgid "The budget arrives as a second thought, the way it does in a real conversation."
msgstr "El límite económico surge sobre la marcha, calcando una conversación habitual en una tienda física."

msgid "Put two real products side by side"
msgstr "Compara dos productos reales en paralelo"

msgid "Compare %1$s and %2$s"
msgstr "Compara %1$s y %2$s"

msgid "Both products, and every value compared, come from this catalog."
msgstr "Los modelos y sus características comparadas proceden fidedignamente de este catálogo."

msgid "Ask for a grounded best match"
msgstr "Pide la alternativa recomendada más fundada"

msgid "Which %s on sale do you recommend?"
msgstr "¿Qué %s rebajado me recomiendas?"

msgid "Which %s do you recommend?"
msgstr "¿Qué %s me recomiendas?"

msgid "Uses a real product family with an active sale item."
msgstr "Emplea una gama real del catálogo que contiene artículos en promoción."

msgid "Uses a product family detected from this catalog."
msgstr "Emplea una familia de productos detectada en este catálogo."

msgid "Catalog family: %s"
msgstr "Familia en catálogo: %s"

msgid "Price intent"
msgstr "Intención orientada al precio"

msgid "Sort the whole catalog by price"
msgstr "Ordenar todo el catálogo por coste"

msgid "what is cheapest today"
msgstr "qué es lo más barato hoy"

msgid "No product named at all, and the answer still comes from live WooCommerce prices."
msgstr "Sin concretar productos, la contestación se fundamenta de inmediato en los precios de WooCommerce."

msgid "Whole catalog"
msgstr "Catálogo global"

msgid "Scope"
msgstr "Alcance"

msgid "Ask the assistant what it covers"
msgstr "Pregunta al asistente sobre su ámbito de ayuda"

msgid "What can you do?"
msgstr "¿Qué sabes hacer?"

msgid "Answers from what this install actually has switched on, not a stock script."
msgstr "Responde estrictamente con las opciones activas de este sitio, sin discursos prefabricados."

msgid "Assistant capabilities"
msgstr "Capacidades del asistente"

msgid "Knowing when to stop"
msgstr "Saber cuándo delegar"

msgid "See it hand a complaint to a person"
msgstr "Comprueba cómo transfiere una queja al equipo humano"

msgid "I want to complain"
msgstr "Quiero poner una reclamación"

msgid "A complaint is not a shopping request, so it stops selling instead of answering with products."
msgstr "Una queja no es una compra: el asistente detiene la venta y orienta la solución con delicadeza."

msgid "Support handover"
msgstr "Derivación a soporte"

msgid "Exact product"
msgstr "Producto concreto"

msgid "Open a real product by name"
msgstr "Acceder a un producto real por su nombre"

msgid "Shows how shoppers can ask for one exact catalog product without browsing menus."
msgstr "Muestra cómo localizar un producto específico sin tener que navegar por menús."

msgid "Price filter"
msgstr "Filtro de presupuesto"

msgid "Test a real budget request"
msgstr "Simula un presupuesto exacto"

msgid "%1$s under %2$s%3$s"
msgstr "%1$s por menos de %2$s%3$s"

msgid "Uses a confirmed current product price from this store."
msgstr "Se apoya en un precio verificado en tiempo real dentro de la tienda."

msgid "in %s"
msgstr "en %s"

msgid "Try color or size language"
msgstr "Prueba con términos de color o medida"

msgid "Uses attributes already indexed from this product."
msgstr "Utiliza propiedades que ya han sido indexadas en este artículo."

msgid "Product Q&A"
msgstr "Preguntas y respuestas sobre productos"

msgid "Check a live stock fact"
msgstr "Verificar existencias en vivo"

msgid "Is %s in stock?"
msgstr "¿Hay stock de %s?"

msgid "Uses the current WooCommerce stock state for this product."
msgstr "Se sirve del estado de inventario vigente en WooCommerce para este modelo."

msgid "Check a confirmed product price"
msgstr "Comprobar el precio exacto de un artículo"

msgid "How much does %s cost?"
msgstr "¿Cuánto vale %s?"

msgid "Uses only the current WooCommerce product price."
msgstr "Solo toma en consideración el precio actualizado de WooCommerce."

msgid "Buying action"
msgstr "Acción de compra"

msgid "Add a real product from chat"
msgstr "Añade un producto auténtico desde el chat"

msgid "Add %s to my cart"
msgstr "Añadir %s a mi carrito"

msgid "Commerce Pro turns the product conversation into a cart action."
msgstr "Commerce Pro convierte una charla sobre productos en una adición al carrito."

msgid "Variation buying"
msgstr "Compra con variaciones"

msgid "Select an option and buy in one sentence"
msgstr "Escoger una opción y comprar en una sola frase"

msgid "Commerce Pro can select a real purchasable variation before adding it to the cart."
msgstr "Commerce Pro elige la combinación comprable correspondiente antes de meterla en la cesta."

msgid "Buying by reference"
msgstr "Compra por alusión posicional"

msgid "Buy the one on screen, unnamed"
msgstr "Comprar el de la pantalla sin nombrarlo"

msgid "add the second one"
msgstr "añade el segundo"

msgid "The shopper points at a position in the results and Commerce Pro carts that product."
msgstr "El usuario señala una posición y Commerce Pro ingresa ese artículo exacto en la cesta."

msgid "Cart assistance"
msgstr "Gestión de la cesta"

msgid "Change a quantity in conversation"
msgstr "Modificar el número de unidades conversando"

msgid "make it quantity 2"
msgstr "pon que sean 2 unidades"

msgid "Commerce Pro updates the line it just created, without the shopper naming it again."
msgstr "Commerce Pro actualiza la línea recién creada sin exigir repetir el nombre del producto."

msgid "Take something back out of the cart"
msgstr "Retirar un artículo de la cesta"

msgid "remove first product from cart"
msgstr "quita el primer producto del carrito"

msgid "Positions are counted in the cart, not in the last search."
msgstr "El orden se cuenta según las líneas del carrito, no respecto a la búsqueda anterior."

msgid "How long does shipping take?"
msgstr "¿Cuánto tarda el envío?"

msgid "Can I return an opened product?"
msgstr "¿Puedo devolver un producto ya abierto?"

msgid "When will I receive my refund?"
msgstr "¿Cuándo recibiré el reembolso?"

msgid "Can I exchange an item for another size?"
msgstr "¿Se puede cambiar un artículo por otra talla?"

msgid "Does this store provide a warranty?"
msgstr "¿Ofrece garantía esta tienda?"

msgid "Which payment methods do you accept?"
msgstr "¿Qué métodos de pago aceptáis?"

msgid "How do you use my personal data?"
msgstr "¿Cómo tratáis mis datos personales?"

msgid "Where can I read the store terms?"
msgstr "¿Dónde puedo consultar los términos de la tienda?"

msgid "Store policy"
msgstr "Políticas de la tienda"

msgid "Test a grounded policy answer"
msgstr "Probar una respuesta fundamentada en políticas"

msgid "Uses one of the public policy pages approved in Store Knowledge."
msgstr "Utiliza una de las páginas públicas ratificadas en Conocimiento de la tienda."

msgid "Policy page: %s"
msgstr "Página de política: %s"

msgid "Choose an available option for %s and add it to my cart"
msgstr "Elige una opción disponible para %s y añádela a mi carrito"

msgid "Choose %1$s for %2$s and add it to my cart"
msgstr "Elige %1$s para %2$s y ponlo en mi cesta"

msgid "Product index table"
msgstr "Tabla del índice de productos"

msgid "The product index table is present."
msgstr "La tabla del índice de productos está presente."

msgid "The product index table is missing, so Geeky Bot cannot search your catalog. Deactivating and reactivating the plugin rebuilds it."
msgstr "Falta la tabla del índice de productos; Geeky Bot no puede buscar en tu catálogo. Desactivar y reactivar el plugin la reconstruirá."

msgid "The product search index is missing. Geeky Bot is falling back to slower matching with no relevance ranking. Reactivate the plugin to rebuild it."
msgstr "Falta el índice de búsqueda de productos. Geeky Bot está recurriendo a un cotejo más lento sin jerarquía de relevancia. Reactiva el plugin para subsanarlo."

msgid "The product search index covers the wrong columns, so every search silently falls back to slower matching with no relevance ranking. Found: %1$s. Expected: %2$s. Reactivating the plugin repairs it."
msgstr "El índice incluye columnas erróneas, provocando búsquedas lentas y sin ponderación de relevancia. Detectadas: %1$s. Esperadas: %2$s. Reactivar el plugin solventa el problema."

msgid "The index looks correct but the last product search failed in the database and fell back to slower matching. Error: %s"
msgstr "El índice aparenta corrección, pero la última consulta falló en base de datos y se degradó a búsqueda lenta. Error: %s"

msgid "The product search index covers the expected columns."
msgstr "El índice de búsqueda de productos abarca las columnas requeridas."

msgid "This store has no published products yet."
msgstr "Esta tienda carece todavía de productos publicados."

msgid "None of your %d published products are indexed, so Geeky Bot cannot recommend anything. Rebuild the product index from the Geeky Bot settings."
msgstr "Ninguno de tus %d productos públicos está indexado, impidiendo que Geeky Bot sugiera nada. Reconstruye el índice desde los ajustes."

msgid "Only %1$d of %2$d published products are indexed. Rebuild the product index so recommendations cover your whole catalog."
msgstr "Solo %1$d de %2$d productos públicos constan indexados. Reconstruye el índice para abarcar la totalidad de tu inventario."

msgid "%1$d of %2$d published products are indexed."
msgstr "%1$d de %2$d productos publicados están indexados."

msgid "Store vocabulary"
msgstr "Vocabulario de la tienda"

msgid "WooCommerce categories are unavailable, so only the built-in vocabulary is used."
msgstr "Las categorías de WooCommerce no son accesibles: solo se empleará el léxico predeterminado."

msgid "No product categories have products in them, so Geeky Bot can only fall back to its built-in wording. Categorising your products teaches it the words your shoppers use."
msgstr "No hay artículos asignados a categorías, por lo que Geeky Bot solo dispone del lenguaje de base. Clasificar tus productos le instruye en el argot que manejan tus clientes."

msgid "Your product categories have not been read yet, so searches rely on built-in wording only. Rebuild the product index to learn them."
msgstr "Aún no se han procesado las categorías de producto; las búsquedas solo emplean el léxico base. Reconstruye el índice para asimilarlas."

msgid "%1$d product words learned from your %2$d categories."
msgstr "%1$d términos asimilados a partir de tus %2$d categorías."

msgid "Store policy answers"
msgstr "Respuestas normativas del comercio"

msgid "No policy pages are selected, so Geeky Bot cannot answer questions about shipping, returns or refunds. Choose your policy pages in the Geeky Bot settings."
msgstr "No hay páginas informativas seleccionadas; Geeky Bot no puede aclarar temas de envíos o reembolsos. Asígnalas en los ajustes del plugin."

msgid "Policy pages are selected but none are indexed, so policy questions fall back to \"please contact the store\". Re-sync your knowledge sources in the Geeky Bot settings."
msgstr "Hay páginas seleccionadas pero ninguna está indexada, por lo que las dudas remitirán a «ponte en contacto con la tienda». Re-sincroniza las fuentes en Ajustes."

msgid "%1$d of %2$d selected policy pages are indexed. Re-sync your knowledge sources so every page can be quoted."
msgstr "%1$d de %2$d páginas de políticas elegidas están indexadas. Re-sincroniza las fuentes para citar todas debidamente."

msgid "%d policy pages are indexed and available for answers."
msgstr "%d páginas normativas indexadas y operativas para formular respuestas."

msgid "Assistant visibility"
msgstr "Visibilidad del asistente"

msgid "The storefront assistant is switched off, so shoppers cannot see Geeky Bot."
msgstr "El asistente está apagado en la tienda: los usuarios no pueden ver a Geeky Bot."

msgid "WooCommerce is not active, so Geeky Bot cannot read your catalog."
msgstr "WooCommerce se encuentra inactivo, impidiendo que Geeky Bot explore el catálogo."

msgid "The storefront assistant is enabled and WooCommerce is active."
msgstr "El asistente está activado y WooCommerce permanece operativo."

msgid "Geeky Bot search health"
msgstr "Estado de salud de búsqueda de Geeky Bot"

msgid "Geeky Bot search is healthy"
msgstr "La búsqueda de Geeky Bot funciona con total normalidad"

msgid "The product index, search index and policy sources are all working."
msgstr "El catálogo, el índice y los textos de políticas operan de forma óptima."

msgid "Geeky Bot search needs attention"
msgstr "La búsqueda de Geeky Bot requiere atención"

msgid "Geeky Bot search is degraded"
msgstr "La búsqueda de Geeky Bot opera en modo degradado"

msgid "Geeky Bot is answering from a degraded state."
msgstr "Geeky Bot está emitiendo respuestas en condiciones degradadas."

msgid "The page is not an approved knowledge source."
msgstr "Esta página no está admitida como fuente autorizada de conocimiento."

msgid "The selected page is not public."
msgstr "La página elegida no tiene carácter público."

msgid "The selected page has no readable public text."
msgstr "La página elegida no presenta texto público legible."

msgid "The policy page could not be indexed."
msgstr "No se pudo indexar la página informativa."

msgid "According to the store’s “%1$s” page: %2$s"
msgstr "Según la página «%1$s» de la tienda: %2$s"

msgid "store policy"
msgstr "política de la tienda"

msgid "I couldn't find this information in the store’s published %s pages. Please contact the store for confirmation."
msgstr "No encontré ese detalle en las páginas oficiales sobre %s. Consulta con la tienda para validarlo."

msgid "I couldn't find that detail in the store’s published %s information. Please review the page below or contact the store for confirmation."
msgstr "No localicé esa especificación en la información pública sobre %s. Revisa el enlace inferior o consúltalo con el comercio."

msgid "Commerce Pro license storage requires the PHP OpenSSL or Sodium extension. Commerce Pro remains locked until secure local storage is available and the license is refreshed."
msgstr "Almacenar la licencia de Commerce Pro precisa las librerías OpenSSL o Sodium en PHP. Permanecerá inactivo hasta disponer de guardado seguro y refrescar la licencia."

msgid "Commerce Pro needs a fresh license verification before it can run on this site."
msgstr "Commerce Pro exige una comprobación reciente de licencia para operar en este dominio."

msgid "Your Commerce Pro license has expired. Buying actions continue on this activated site, but updates, protected downloads, support, and new activations require renewal."
msgstr "Tu licencia de Commerce Pro ha vencido. Las acciones de compra persisten en esta web, pero soporte, descargas, parches y nuevos dominios requieren renovación."

msgid "Your Commerce Pro subscription is cancelled but remains active until the paid period ends. Renew to keep updates, downloads, and support active after expiry."
msgstr "Tu suscripción a Commerce Pro está cancelada aunque activa hasta terminar el período abonado. Renuévala para retener soporte y actualizaciones futuras."

msgid "Could not refresh the Commerce Pro license recently. Commerce Pro is running on cached verification until the grace period expires."
msgstr "No ha sido factible refrescar la licencia hace poco. Commerce Pro opera con validación en caché hasta agotarse el período de gracia."

msgid "Staging limit reached"
msgstr "Límite de entornos de prueba alcanzado"

msgid "Production limit reached"
msgstr "Límite de entornos de producción alcanzado"

msgid "This server cannot securely store the Commerce Pro license key. Enable the PHP OpenSSL or Sodium extension, then try again."
msgstr "Este servidor no puede resguardar con seguridad la licencia de Commerce Pro. Activa OpenSSL o Sodium en PHP e inténtalo nuevamente."

msgid "Please enter a license key."
msgstr "Introduce una clave de licencia, por favor."

