msgstr "Nombre"

msgid "Email"
msgstr "Correo electrónico"

msgid "Message"
msgstr "Mensaje"

msgid "Date"
msgstr "Fecha"

msgid "No leads captured yet"
msgstr "Aún no se han capturado clientes potenciales"

msgid "Lead and human handoff requests will appear here after shoppers use the assistant."
msgstr "Las solicitudes de contacto y transferencia humana aparecerán aquí cuando los clientes utilicen el asistente."

