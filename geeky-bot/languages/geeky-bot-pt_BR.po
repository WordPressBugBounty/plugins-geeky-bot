msgstr "Configurações do Commerce Pro"

msgid "Activate License"
msgstr "Ativar licença"

msgid "Security check failed. Please refresh the page and try again."
msgstr "Falha na verificação de segurança. Atualize a página e tente novamente."

msgid "WooCommerce cart is not available."
msgstr "O carrinho do WooCommerce não está disponível."

msgid "Cart commands are disabled."
msgstr "Os comandos do carrinho estão desativados."

msgid "Add to cart is disabled."
msgstr "A opção de adicionar ao carrinho está desativada."

msgid "This product is not available."
msgstr "Este produto não está disponível."

msgid "This product needs options before it can be added to cart."
msgstr "Este produto requer a seleção de opções antes de ser adicionado ao carrinho."

msgid "Open the product page to choose the available buying options."
msgstr "Abra a página do produto para escolher as opções de compra disponíveis."

msgid "This product cannot be purchased right now."
msgstr "Este produto não pode ser adquirido no momento."

msgid "This product is out of stock."
msgstr "Este produto está esgotado."

msgid "The product could not be added to cart."
msgstr "Não foi possível adicionar o produto ao carrinho."

msgid "WooCommerce accepted the request, but the product was not safely verified in the cart. Please try again or open the product page."
msgstr "O WooCommerce aceitou o pedido, mas o item não pôde ser verificado no carrinho. Tente novamente ou abra a página do produto."

msgid "%s has been added to your cart."
msgstr "%s foi adicionado ao seu carrinho."

