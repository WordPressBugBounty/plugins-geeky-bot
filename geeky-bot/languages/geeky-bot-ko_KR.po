msgstr "색인된 상품"

msgid "Policy sources"
msgstr "정책 문서 출처"

msgid "WooCommerce catalog is checked before launch."
msgstr "출시 전 WooCommerce 카탈로그 연동 상태를 확인합니다."

msgid "Search index, policy pages, widget and privacy are reviewed."
msgstr "검색 색인, 정책 문서, 위젯 및 개인정보 보호 항목을 점검합니다."

msgid "Final test links keep setup focused."
msgstr "최종 테스트 링크를 통해 핵심 기능 검증에 집중할 수 있습니다."

msgid "Products shown"
msgstr "표시된 상품"

msgid "Placement"
msgstr "위치"

msgid "Widget preview follows the live storefront panel."
msgstr "위젯 미리보기가 실제 쇼핑몰 패널과 동일하게 작동합니다."

msgid "Welcome copy, fallback text and product card volume are controlled here."
msgstr "환영 인사말, 미확인 대체 응답, 상품 카드 표시 개수를 이곳에서 설정합니다."

msgid "Scoped frontend CSS avoids theme layout changes."
msgstr "격리된 프론트엔드 CSS를 사용하여 기존 테마의 레이아웃이 깨지지 않습니다."

msgid "Buyer language"
msgstr "구매자 자연어"

