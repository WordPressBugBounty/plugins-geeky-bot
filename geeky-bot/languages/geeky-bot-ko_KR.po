msgstr "관리자가 승인한 실제 유효 쿠폰만 엄격하고 안전하게 노출합니다."

msgid "Leads and human handoff"
msgstr "리드 수집 및 상담원 연결"

msgid "Capture follow-up requests when a human touch is needed."
msgstr "사람의 응대가 필요할 때 고객의 연락처와 문의 사항을 수집합니다."

msgid "Try before you buy"
msgstr "도입 전 미리 체험하기"

msgid "See it on your own store data"
msgstr "내 쇼핑몰 데이터로 직접 확인"

msgid "Guided Demo generates real shopper requests from your indexed products and labels the buying actions that Commerce Pro completes."
msgstr "체험 데모를 통해 실제 등록된 상품을 기반으로 고객 질문을 재현하고, Commerce Pro가 어떻게 구매를 완결하는지 확인해 보세요."

msgid "Getting started"
msgstr "시작하기"

msgid "Live in three steps"
msgstr "3단계로 즉시 운영 시작"

msgid "No FTP and no manual ZIP handling — everything happens from this dashboard."
msgstr "FTP 접속이나 수동 ZIP 업로드 없이, 모든 과정이 이 관리자 대시보드 안에서 해결됩니다."

msgid "Get a license"
msgstr "라이선스 구매"

msgid "Purchase Commerce Pro on geekybot.com."
msgstr "geekybot.com에서 Commerce Pro를 구매하세요."

msgid "Activate it here"
msgstr "여기서 키 등록 및 활성화"

msgid "Enter the key on the Add-ons page to authorize this site."
msgstr "부가 기능 페이지에 키를 입력하여 이 사이트의 사용 권한을 등록하세요."

msgid "Install with one click"
msgstr "클릭 한 번으로 간편 설치"

msgid "The protected add-on installs and updates from this dashboard."
msgstr "보안 애드온의 설치와 업데이트가 이 대시보드에서 직접 이루어집니다."

msgid "Open license page"
msgstr "라이선스 페이지 열기"

msgid "Rebuilding the product search index in the background (%1$s of %2$s products). Shoppers keep searching the current index until the new one is ready."
msgstr "백그라운드에서 상품 검색 색인을 다시 생성하는 중입니다 (%2$s개 중 %1$s개 완료). 새 색인이 준비될 때까지 고객은 기존 색인으로 계속 검색할 수 있습니다."

msgid "Product search index rebuilt. Indexed: %1$s. Skipped: %2$s."
msgstr "상품 검색 색인 재구축 완료. 색인됨: %1$s개, 제외됨: %2$s개."

msgid "Buyer search settings saved."
msgstr "구매자 검색 설정이 저장되었습니다."

msgid "Default synonyms restored."
msgstr "기본 동의어가 복원되었습니다."

msgid "Buyer search settings reset to defaults."
msgstr "구매자 검색 설정이 기본값으로 초기화되었습니다."

msgid "Draft"
msgstr "임시글"

msgid "Keyword search"
msgstr "키워드 검색"

msgid "Conversation review"
msgstr "대화 검토"

msgid "conversations"
msgstr "건의 대화"

msgid "messages stored"
msgstr "개의 메시지 저장됨"

msgid "need review"
msgstr "건 검토 필요"

