msgid "Commerce Pro"
msgstr "كوميرس برو"

msgid "Buying actions inside the assistant: variations, cart, checkout handoff, order help, recommendations, coupons and leads."
msgstr "إجراءات الشراء داخل المساعد: المتغيرات، سلة التسوق، تسليم إتمام الشراء، المساعدة في الطلبات، التوصيات، القسائم والعملاء المحتملين."

msgid "%1$s of %2$s features on"
msgstr "%1$s من أصل %2$s ميزة مفعلة"

msgid "WooCommerce inactive"
msgstr "متجر وو كيمرس غير مفعل"

msgid "add-to-cart actions"
msgstr "إجراءات إضافة إلى السلة"

msgid "cart updates"
msgstr "تحديثات سلة التسوق"

msgid "Test on storefront"
msgstr "اختبار على واجهة المتجر"

msgid "Assistant settings"
msgstr "إعدادات المساعد"

msgid "Dashboard"
msgstr "لوحة التحكم"

msgid "WooCommerce is not active. Commerce Pro buying actions need WooCommerce."
msgstr "ووكوميرس غير مفعل. تتطلب إجراءات الشراء في كوميرس برو تفعيل ووكوميرس."

msgid "Commerce Pro settings saved."
msgstr "تم حفظ إعدادات كوميرس برو."

msgid "Commerce Pro settings imported."
msgstr "تم استيراد إعدادات كوميرس برو."

msgid "Settings import failed. Please upload a valid Commerce Pro settings JSON file."
msgstr "فشل استيراد الإعدادات. يرجى رفع ملف JSON صالح لإعدادات كوميرس برو."

msgid "Commerce Pro readiness"
msgstr "جاهزية كوميرس برو"

msgid "Buying actions"
msgstr "إجراءات الشراء"

msgid "Add-to-cart and variation selection"
msgstr "الإضافة إلى السلة واختيار المتغيرات"

msgid "Cart buttons active"
msgstr "أزرار السلة مفعلة"

msgid "Cart flow"
msgstr "تدفق سلة التسوق"

msgid "View, update and checkout handoff"
msgstr "العرض، التحديث وتسليم إتمام الشراء"

msgid "Checkout handoff ready"
msgstr "تسليم إتمام الشراء جاهز"

msgid "Sales assistance"
msgstr "المساعدة في المبيعات"

msgid "Compare, recommend and coupons"
msgstr "المقارنة، التوصية والقسائم"

msgid "Buyer guidance active"
msgstr "إرشاد المشتري مفعل"

msgid "Handoff"
msgstr "التسليم"

msgid "Lead capture and human follow-up"
msgstr "جذب العملاء المحتملين والمتابعة البشرية"

msgid "Follow-up forms active"
msgstr "نماذج المتابعة مفعلة"

msgid "Guardrails"
msgstr "ضوابط الأمان"

msgid "Tone, claims and analytics safety"
msgstr "سلامة النبرة، الادعاءات والتحليلات"

msgid "Safe sales mode"
msgstr "وضع المبيعات الآمن"

msgid "Sales action intelligence"
msgstr "ذكاء إجراءات المبيعات"

msgid "Buying actions handled by the assistant"
msgstr "إجراءات الشراء التي يتعامل معها المساعد"

msgid "Track the buying actions Commerce Pro adds on top of product discovery."
msgstr "تتبع إجراءات الشراء التي يضيفها كوميرس برو فوق اكتشاف المنتجات."

msgid "Add-to-cart"
msgstr "إضافة إلى السلة"

msgid "Simple and variation cart adds"
msgstr "إضافات المنتجات البسيطة والمتغيرة إلى السلة"

msgid "Quantity and remove actions"
msgstr "إجراءات الكمية والإزالة"

msgid "Checkout handoffs"
msgstr "عمليات تسليم إتمام الشراء"

msgid "Checkout clicks from the assistant"
msgstr "نقرات إتمام الشراء من المساعد"

msgid "Order lookups"
msgstr "بحث الطلبات"

msgid "Customer order helper"
msgstr "مساعد طلبات العملاء"

msgid "Comparisons"
msgstr "المقارنات"

msgid "Product comparison intent"
msgstr "نية مقارنة المنتجات"

msgid "Recommendations"
msgstr "التوصيات"

msgid "Smart product suggestions"
msgstr "اقتراحات المنتجات الذكية"

msgid "Leads"
msgstr "العملاء المحتملون"

msgid "Follow-up captures"
msgstr "التقاطات المتابعة"

msgid "Coupon views"
msgstr "مشاهدات القسائم"

msgid "Safe coupon exposure"
msgstr "عرض القسائم الآمن"

msgid "Product intent"
msgstr "نية المنتج"

msgid "Top products by assistant intent"
msgstr "أفضل المنتجات حسب نية المساعد"

msgid "Products receiving assistant clicks, comparisons, recommendations, and cart actions."
msgstr "المنتجات التي تتلقى نقرات المساعد، المقارنات، التوصيات، وإجراءات السلة."

msgid "Unknown product"
msgstr "منتج غير معروف"

msgid "No product intent yet"
msgstr "لا توجد نية للمنتج بعد"

msgid "Test product search, compare, add-to-cart and checkout phrases in the storefront widget."
msgstr "اختبار عبارات البحث عن المنتجات، المقارنة، الإضافة إلى السلة وإتمام الشراء في عنصر واجهة المتجر."

msgid "Sales flow readiness"
msgstr "جاهزية تدفق المبيعات"

msgid "Buying path must stay ready"
msgstr "يجب أن يظل مسار الشراء جاهزاً"

msgid "Main buyer actions should stay enabled for Commerce Pro to prove value."
msgstr "يجب أن تظل إجراءات المشتري الرئيسية مفعلة لكي يثبت كوميرس برو قيمته."

msgid "WooCommerce actions"
msgstr "إجراءات ووكوميرس"

msgid "Cart and order APIs are available."
msgstr "واجهات برمجة التطبيقات للسلة والطلبات متاحة."

msgid "Activate WooCommerce."
msgstr "تفعيل ووكوميرس."

msgid "Buying through the assistant"
msgstr "الشراء عبر المساعد"

msgid "Simple products and variations can be added through the assistant."
msgstr "يمكن إضافة المنتجات البسيطة والمتغيرات من خلال المساعد."

msgid "Cart and checkout"
msgstr "السلة وإتمام الشراء"

msgid "Shoppers can review cart, update items, and move to checkout."
msgstr "يمكن للمتسوقين مراجعة السلة، تحديث العناصر، والانتتقال إلى إتمام الشراء."

msgid "Order helper"
msgstr "مساعد الطلبات"

msgid "Logged-in customers can view their own recent orders."
msgstr "يمكن للعملاء المسجلين دخولهم عرض طلباتهم الأخيرة."

msgid "Next best action"
msgstr "الإجراء الأفضل التالي"

msgid "Test the full buying journey"
msgstr "اختبار رحلة الشراء الكاملة"

msgid "Run shopper phrases that prove search, comparison, cart, checkout, orders, coupons, and human handoff stay separated."
msgstr "تشغيل عبارات المتسوقين التي تثبت أن البحث، المقارنة، السلة، إتمام الشراء، الطلبات، القسائم، والتسليم البشري تظل منفصلة."

msgid "Test storefront widget"
msgstr "اختبار أداة واجهة المتجر"

msgid "Feature checklist"
msgstr "قائمة تدقيق الميزات"

msgid "What the feature count means"
msgstr "ماذا تعني عدد الميزات"

msgid "%1$s of %2$s on"
msgstr "%1$s من أصل %2$s مفعلة"

msgid "On, inactive"
msgstr "مفعل، غير نشط"

msgid "On"
msgstr "مفعل"

msgid "Off"
msgstr "متوقف"

msgid "The last two count only once you have entered coupon codes or written sales rules, not merely enabled the switch."
msgstr "يتم احتساب الأخيرتين فقط بمجرد إدخال رموز القسائم أو كتابة قواعد المبيعات، وليس مجرد تفعيل المفتاح."

msgid "Commerce Pro settings"
msgstr "إعدادات كوميرس برو"

msgid "Configure buying actions and guardrails"
msgstr "تكوين إجراءات الشراء وضوابط الأمان"

msgid "Keep purchase actions enabled unless you are testing a specific feature. These controls affect the live shopper assistant after saving."
msgstr "ابقِ إجراءات الشراء مفعلة ما لم تكن تختبر ميزة معينة. تؤثر هذه العناصر على مساعد المتسوق الحي بعد الحفظ."

msgid "Commerce Pro settings sections"
msgstr "أقسام إعدادات كوميرس برو"

msgid "Lead and handoff"
msgstr "العملاء المحتملون والتسليم"

msgid "AI guardrails"
msgstr "ضوابط الذكاء الاصطناعي"

msgid "Buyer actions"
msgstr "إجراءات المشتري"

msgid "Active"
msgstr "نشط"

msgid "Needs attention"
msgstr "يحتاج إلى انتباه"

msgid "Checkout flow"
msgstr "تدفق إتمام الشراء"

msgid "Ready"
msgstr "جاهز"

msgid "Review"
msgstr "مراجعة"

msgid "Sales rules"
msgstr "قواعد المبيعات"

msgid "Enabled"
msgstr "مفعل"

msgid "Optional"
msgstr "اختياري"

msgid "Save Commerce Pro Settings"
msgstr "حفظ إعدادات كوميرس برو"

msgid "Add to cart through assistant"
msgstr "الإضافة إلى السلة عبر المساعد"

msgid "Show add-to-cart buttons for simple products and option selectors for variable products."
msgstr "إظهار أزرار الإضافة إلى السلة للمنتجات البسيطة ومحددات الخيارات للمنتجات المتغيرة."

msgid "Variation selection"
msgstr "اختيار المتغيرات"

msgid "Let shoppers choose variable product attributes directly inside the storefront assistant."
msgstr "السماح للمتسوقين باختيار خصائص المنتجات المتغيرة مباشرة داخل مساعد واجهة المتجر."

msgid "Cart requests"
msgstr "طلبات السلة"

msgid "Let shoppers ask for their cart and update items through the assistant."
msgstr "السماح للمتسوقين بالسؤال عن سلتهم وتحديث العناصر عبر المساعد."

msgid "Cart quantity controls"
msgstr "عناصر التحكم في كمية السلة"

msgid "Show plus, minus, and remove controls in the assistant cart view."
msgstr "إظهار عناصر التحكم في الإضافة، الطرح، والإزالة في عرض سلة المساعد."

msgid "Checkout handoff"
msgstr "تسليم إتمام الشراء"

msgid "Show a checkout button only when the cart has items."
msgstr "إظهار زر إتمام الشراء فقط عندما تحتوي السلة على عناصر."

msgid "Order lookup"
msgstr "بحث الطلب"

msgid "Allow logged-in customers to ask for their own recent orders and order status."
msgstr "السماح للعملاء المسجلين بالسؤال عن طلباتهم الأخيرة وحالة الطلب."

msgid "Product comparison"
msgstr "مقارنة المنتجات"

msgid "Let shoppers compare catalog products inside the storefront assistant."
msgstr "السماح للمتسوقين بمقارنة منتجات الكتالوج داخل مساعد واجهة المتجر."

msgid "Smart recommendations"
msgstr "التوصيات الذكية"

msgid "Show related, upsell, and cross-sell products from WooCommerce data."
msgstr "إظهار المنتجات ذات الصلة، والارتقائية، والتكميلية من بيانات ووكوميرس."

msgid "Safe coupon suggestions"
msgstr "اقتراحات القسائم الآمنة"

msgid "Only show coupon codes explicitly allowlisted below. The assistant will not invent coupon codes."
msgstr "عرض رموز القسائم المسموح بها صراحة أدناه فقط. لن يبتكر المساعد رموز قسائم."

msgid "Public coupon codes"
msgstr "رموز القسائم العامة"

msgid "Enter one public coupon code per line. Only valid, published, non-expired coupons from this list can be shown in the assistant."
msgstr "أدخل رمز قسيمة عام واحد لكل سطر. يمكن فقط عرض القسائم الصالحة والمنشورة وغير المنتهية الصلاحية من هذه القائمة في المساعد."

msgid "Product sales rules"
msgstr "قواعد مبيعات المنتجات"

msgid "Show merchant-written sales notes for products, categories, tags, keywords, or globally."
msgstr "إظهار ملاحظات المبيعات التي كتبها التاجر للمنتجات، الفئات، العلامات، الكلمات الرئيسية، أو بشكل عام."

msgid "One rule per line. Examples: product:123 | Mention sizing runs small. category:shoes | Recommend checking size and return policy. global | Free shipping over $50."
msgstr "قاعدة واحدة لكل سطر. أمثلة: product:123 | اذكر أن المقاسات أصغر من المعتاد. category:shoes | نوصي بمراجعة المقاس وسياسة الاسترجاع. global | شحن مجاني لأكثر من 50 دولاراً."

msgid "Abandoned-cart prompts"
msgstr "تنبيهات السلة المتروكة"

msgid "After a shopper adds items but stays on the site, gently remind them that checkout is available once per session."
msgstr "بعد أن يضيف المتسوق عناصر ولكنه يبقى في الموقع، تذكيره بلطف بأن إتمام الشراء متاح مرة واحدة لكل جلسة."

msgid "Cart prompt delay"
msgstr "تأخير تنبيه السلة"

msgid "Seconds to wait before showing the cart reminder in the assistant. Allowed range: 15 to 600 seconds."
msgstr "الثواني المنتظرة قبل إظهار تذكير السلة في المساعد. النطاق المسموح به: من 15 إلى 600 ثانية."

msgid "Lead capture and handoff"
msgstr "التقاط العملاء المحتملين والتسليم"

msgid "Lead capture"
msgstr "التقاط العملاء المحتملين"

msgid "Let shoppers leave their name, email, and question when they need follow-up."
msgstr "السماح للمتسوقين ترك اسمهم، بريدهم الإلكتروني، وسؤالهم عندما يحتاجون إلى متابعة."

msgid "Human handoff"
msgstr "التسليم البشري"

msgid "Show a human handoff form for questions the assistant cannot complete."
msgstr "إظهار نموذج تسليم بشري الأسئلة التي لا يستطيع المساعد إكمالها."

msgid "Handoff email"
msgstr "بريد التسليم الإلكتروني"

msgid "New lead notifications are sent here. Leave empty to use the WordPress admin email."
msgstr "يتم إرسال إشعارات العملاء المحتملين الجدد إلى هنا. اترك الحقل فارغاً لاستخدام بريد مسؤول ووردبريس."

msgid "AI sales rules and guardrails"
msgstr "قواعد مبيعات وضوابط الذكاء الاصطناعي"

msgid "Multilingual sales assistant"
msgstr "مساعد مبيعات متعدد اللغات"

msgid "Add language instructions to the grounded AI layer while keeping product names, SKUs, coupons, and policy titles unchanged."
msgstr "إضافة تعليمات اللغة إلى طبقة الذكاء الاصطناعي مع إبقاء أسماء المنتجات، وحدات التخزين، القسائم، وعناوين السياسات دون تغيير."

msgid "Language mode"
msgstr "وضع اللغة"

msgid "Auto replies in the shopper language, site follows WordPress locale, and force uses the language field below."
msgstr "الرد التلقائي بلغة المتسوق، الموقع يتبع لغة ووردبريس، أو فرض استخدام حقل اللغة أدناه."

msgid "Auto-detect shopper language"
msgstr "الكشف التلقائي عن لغة المتسوق"

msgid "Use site language"
msgstr "استخدام لغة الموقع"

msgid "Force selected language"
msgstr "فرض اللغة المحددة"

msgid "Forced language"
msgstr "اللغة المفروضة"

msgid "Example: English, Arabic, Spanish, German, French, Urdu. Used only when language mode is force."
msgstr "مثال: الإنجليزية، العربية، الإسبانية، الألمانية، الفرنسية، الأوردو. يُستخدم فقط عندما يكون وضع اللغة مضبوطاً على فرض."

msgid "Assistant tone"
msgstr "نبرة المساعد"

msgid "Controls AI answer style without changing product facts."
msgstr "يتحكم في أسلوب إجابة الذكاء الاصطناعي دون تغيير حقائق المنتجات."

msgid "Helpful"
msgstr "مفيد"

msgid "Friendly"
msgstr "ودود"

msgid "Premium retail"
msgstr "تجزئة مميزة"

msgid "Concise"
msgstr "موجز"

msgid "Extra sales guardrails"
msgstr "ضوابط مبيعات إضافية"

msgid "Strengthen rules against unsupported claims, invented offers, private coupons, and unsafe guarantees."
msgstr "تعزيز القواعد ضد الادعاءات غير المدعومة، العروض المبتكرة، القسائم الخاصة، والضمانات غير الآمنة."

msgid "Blocked / restricted claim topics"
msgstr "مواضيع الادعاءات المحظورة / المقيدة"

msgid "One topic per line. The assistant will be extra careful and refuse unsupported claims in these areas."
msgstr "موضوع واحد لكل سطر. سيكون المساعد شديد الحرص ويرفض الادعاءات غير المدعومة في هذه المجالات."

msgid "Store-approved sales guidance"
msgstr "إرشادات المبيعات المعتمدة من المتجر"

msgid "Optional approved guidance lines. Keep this factual and grounded, such as size advice or support instructions."
msgstr "خطوط إرشادية معتمدة اختيارية. اجعلها واقعية ومستندة للحقائق، مثل نصائح المقاسات أو تعليمات الدعم."

msgid "Product-intent analytics"
msgstr "تحليلات نية المنتج"

msgid "Track safe aggregate events such as comparisons, recommendations, cart actions, order lookups, coupon views, leads, and sales notes."
msgstr "تتبع الأحداث المجمعة الآمنة مثل المقارنات، التوصيات، إجراءات السلة، بحث الطلبات، مشاهدات القسائم، العملاء المحتملين، وملاحظات المبيعات."

msgid "Save Commerce Pro settings"
msgstr "حفظ إعدادات كوميرس برو"

msgid "Frontend buyer actions use these settings immediately after saving."
msgstr "تستخدم إجراءات المشتري في الواجهة الأمامية هذه الإعدادات مباشرة بعد الحفظ."

msgid "Portable setup"
msgstr "إعداد قابل للنقل"

msgid "Import / export settings"
msgstr "استيراد / تصدير الإعدادات"

msgid "Use this for staging-to-live moves, support handoff, and repeatable setup. Secrets are not included."
msgstr "استخدم هذا للاختبار والانتقال للإنتاج، تسليم الدعم، والإعداد القابل للتكرار. الأسرار غير متضمنة."

msgid "Export settings JSON"
msgstr "تصدير إعدادات JSON"

msgid "Import settings JSON"
msgstr "استيراد إعدادات JSON"

msgid "Human follow-up"
msgstr "المتابعة البشرية"

msgid "Recent leads"
msgstr "العملاء المحتملون الأخيرون"

msgid "Latest handoff and lead-capture requests from the assistant."
msgstr "أحدث طلبات التسليم والتقاط العملاء المحتملين من المساعد."

msgid "Name"
msgstr "الاسم"

msgid "Email"
msgstr "البريد الإلكتروني"

msgid "Message"
msgstr "الرسالة"

msgid "Date"
msgstr "التاريخ"

msgid "No leads captured yet"
msgstr "لم يتم التقاط أي عملاء محتملين بعد"

msgid "Lead and human handoff requests will appear here after shoppers use the assistant."
msgstr "ستظهر طلبات العملاء المحتملين والتسليم البشري هنا بعد استخدام المتسوقين للمساعد."

msgid "Add to cart"
msgstr "أضف إلى السلة"

msgid "Coupon suggestions"
msgstr "اقتراحات القسائم"

msgid "Multilingual replies"
msgstr "ردود متعددة اللغات"

msgid "Needs Zywrap or OpenAI. Local mode does not generate text."
msgstr "يحتاج إلى Zywrap أو OpenAI. الوضع المحلي لا يقوم بتوليد النصوص."

msgid "Local mode never generates free text, so nothing needs constraining."
msgstr "الوضع المحلي لا يولد أبداً نصاً حراً، لذا لا شيء يحتاج إلى قيود."

msgid "Public coupon codes added"
msgstr "تمت إضافة رموز القسائم العامة"

msgid "The switch is on; add codes for it to have anything to offer."
msgstr "المفتاح مفعل؛ أضف الرموز ليكون لديه ما يقدمه."

msgid "Sales rules written"
msgstr "تمت كتابة قواعد المبيعات"

msgid "The switch is on; write a rule for it to have anything to say."
msgstr "المفتاح مفعل؛ اكتب قاعدة ليكون لديه ما يقوله."

msgid "Activate Commerce Pro on this site"
msgstr "تفعيل كوميرس برو على هذا الموقع"

msgid "The add-on is installed, but buying actions stay disabled until Geeky Bot confirms a valid license for this site."
msgstr "الإضافة مثبتة، ولكن إجراءات الشراء تظل معطلة حتى يؤكد غيكي بوت وجود ترخيص صالح لهذا الموقع."

msgid "Not activated"
msgstr "غير مفعل"

msgid "No key"
msgstr "لا يوجد مفتاح"

msgid "license key"
msgstr "مفتاح الترخيص"

msgid "Never"
msgstr "أبداً"

msgid "last checked"
msgstr "آخر فحص"

msgid "Open license screen"
msgstr "فتح شاشة الترخيص"

msgid "Plugins"
msgstr "الإضافات"

msgid "Buying actions are disabled"
msgstr "إجراءات الشراء معطلة"

msgid "Storefront Pro buttons are not loaded."
msgstr "أزرار ستورفرونت برو غير محملة."

msgid "Cart, comparison, coupon, lead and order endpoints require license authorization."
msgstr "نقاط النهاية للسلة، المقارنة، القسيمة، العملاء المحتملين والطلبات تتطلب ترخيصاً."

msgid "Free product discovery still works in Geeky Bot core."
