msgstr "Product bekijken"

msgid "Contact store team"
msgstr "Contact opnemen met winkelteam"

msgid "Talk to a human"
msgstr "Spreek met een medewerker"

msgid "Please leave your details and the store team will contact you."
msgstr "Laat uw gegevens achter, dan neemt het winkelteam contact met u op."

msgid "Your name"
msgstr "Uw naam"

msgid "Your email"
msgstr "Uw e-mailadres"

msgid "Your question"
msgstr "Uw vraag"

msgid "Send request"
msgstr "Aanvraag versturen"

msgid "Check coupons"
msgstr "Kortingsbonnen controleren"

msgid "Sales note"
msgstr "Verkoopnotitie"

msgid "Additional store information for this product:"
msgstr "Aanvullende winkelinformatie voor dit product:"

msgid "No additional sales information is available for this product."
msgstr "Er is geen aanvullende verkoopinformatie beschikbaar voor dit product."

msgid "You still have items in your cart. Ready to continue?"
msgstr "Er zitten nog artikelen in uw winkelwagen. Klaar om verder te gaan?"

msgid "I couldn't find a coupon code available to share right now."
msgstr "Ik kon op dit moment geen beschikbare kortingscode vinden."

msgid "Copy code"
msgstr "Code kopiëren"

msgid "Copied"
msgstr "Gekopieerd"

msgid "I couldn't complete that action right now. Please try again."
msgstr "Ik kon die actie nu niet voltooien. Probeer het opnieuw."

msgid "Geeky Bot Commerce Pro could not complete its database update. Please reload the page, then contact support if the notice remains."
msgstr "Geeky Bot Commerce Pro kon de database-update niet voltooien. Herlaad de pagina en neem contact op met support als de melding blijft staan."

msgid "Geeky Bot Commerce Pro requires the Geeky Bot core plugin to be installed and active."
msgstr "Geeky Bot Commerce Pro vereist dat de Geeky Bot-hoofdplugin geïnstalleerd en actief is."

msgid "Geeky Bot Commerce Pro requires Geeky Bot core %1$s or newer. The installed Core version is %2$s."
msgstr "Geeky Bot Commerce Pro vereist Geeky Bot core %1$s of nieuwer. De geïnstalleerde Core-versie is %2$s."

msgid "unknown"
msgstr "onbekend"

msgid "Commerce Pro Settings"
msgstr "Commerce Pro-instellingen"

msgid "Activate License"
msgstr "Licentie activeren"

msgid "Security check failed. Please refresh the page and try again."
msgstr "Beveiligingscontrole mislukt. Vernieuw de pagina en probeer het opnieuw."

msgid "WooCommerce cart is not available."
msgstr "WooCommerce-winkelwagen is niet beschikbaar."

msgid "Cart commands are disabled."
msgstr "Winkelwagen-opdrachten zijn uitgeschakeld."

msgid "Add to cart is disabled."
msgstr "Aan winkelwagen toevoegen is uitgeschakeld."

msgid "This product is not available."
msgstr "Dit product is niet beschikbaar."

msgid "This product needs options before it can be added to cart."
msgstr "Voor dit product moeten opties worden gekozen voordat het kan worden toegevoegd."

msgid "Open the product page to choose the available buying options."
