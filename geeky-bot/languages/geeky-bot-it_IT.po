msgstr "La seconda richiesta non cita nessun nome: viene elaborata basandosi direttamente sui risultati visibili a schermo."

msgid "Comparison"
msgstr "Confronto"

msgid "Compare by position, not by name"
msgstr "Confronta in base alla posizione invece di riscrivere i nomi"

msgid "compare the first and second"
msgstr "confronta il primo e il secondo"

