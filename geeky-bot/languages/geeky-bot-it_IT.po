msgstr "Ho reperito molteplici prodotti pubblici per \"%1$s\": %2$s e %3$s. Specifica la denominazione per intero."

msgid "I couldn't find a visible store product matching “%s”."
msgstr "Non ho trovato alcun articolo pubblico che corrisponda a \"%s\"."

