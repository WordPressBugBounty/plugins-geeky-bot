msgstr "E-mail"

msgid "Message"
msgstr "Message"

msgid "Date"
msgstr "Date"

msgid "No leads captured yet"
msgstr "Aucun prospect collecté pour le moment"

msgid "Lead and human handoff requests will appear here after shoppers use the assistant."
msgstr "Les sollicitations de contact et de transfert humain apparaîtront ici dès l'utilisation par vos visiteurs."

