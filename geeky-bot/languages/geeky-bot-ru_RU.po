msgstr "Использует подтвержденную текущую цену товара из этого магазина."

msgid "in %s"
msgstr "в категории %s"

msgid "Try color or size language"
msgstr "Проверьте запросы с цветом или размером"

msgid "Uses attributes already indexed from this product."
msgstr "Использует характеристики, уже внесенные в индекс этого товара."

msgid "Product Q&A"
msgstr "Вопросы и ответы о товаре"

msgid "Check a live stock fact"
msgstr "Проверить наличие на складе"

msgid "Is %s in stock?"
msgstr "Есть ли %s в наличии?"

msgid "Uses the current WooCommerce stock state for this product."
msgstr "Использует реальный статус наличия из WooCommerce для этой позиции."

msgid "Check a confirmed product price"
msgstr "Узнать точную цену товара"

msgid "How much does %s cost?"
msgstr "Сколько стоит %s?"

msgid "Uses only the current WooCommerce product price."
msgstr "Использует только подтвержденную текущую цену из WooCommerce."

msgid "Buying action"
msgstr "Действие покупки"

msgid "Add a real product from chat"
msgstr "Добавить реальный товар прямо из чата"

msgid "Add %s to my cart"
msgstr "Добавь %s в корзину"

msgid "Commerce Pro turns the product conversation into a cart action."
msgstr "Commerce Pro превращает диалог о товаре в реальное добавление в корзину."

msgid "Variation buying"
msgstr "Покупка с выбором опций"

msgid "Select an option and buy in one sentence"
msgstr "Выбор параметров и заказ в одной фразе"

msgid "Commerce Pro can select a real purchasable variation before adding it to the cart."
msgstr "Commerce Pro умеет определять нужную вариацию товара перед отправкой в корзину."

msgid "Buying by reference"
msgstr "Покупка по указанию"

msgid "Buy the one on screen, unnamed"
msgstr "Купить товар с экрана, не называя его"

msgid "add the second one"
msgstr "добавь второй вариант"

msgid "The shopper points at a position in the results and Commerce Pro carts that product."
msgstr "Покупатель называет порядковый номер, и Commerce Pro кладет этот товар в корзину."

msgid "Cart assistance"
msgstr "Помощь с корзиной"

msgid "Change a quantity in conversation"
msgstr "Изменение количества в процессе беседы"

msgid "make it quantity 2"
msgstr "сделай 2 штуки"

msgid "Commerce Pro updates the line it just created, without the shopper naming it again."
msgstr "Commerce Pro обновляет добавленную строку без необходимости снова называть товар."

msgid "Take something back out of the cart"
msgstr "Удаление лишней позиции из корзины"

msgid "remove first product from cart"
msgstr "удали первый товар из корзины"

msgid "Positions are counted in the cart, not in the last search."
msgstr "Порядковые номера считаются по списку в корзине, а не в выдаче поиска."

msgid "How long does shipping take?"
msgstr "Сколько времени занимает доставка?"

msgid "Can I return an opened product?"
msgstr "Можно ли вернуть распакованный товар?"

msgid "When will I receive my refund?"
msgstr "Когда мне вернут деньги?"

msgid "Can I exchange an item for another size?"
msgstr "Можно ли обменять вещь на другой размер?"

msgid "Does this store provide a warranty?"
msgstr "Предоставляет ли магазин гарантию?"

msgid "Which payment methods do you accept?"
msgstr "Какие способы оплаты вы принимаете?"

msgid "How do you use my personal data?"
msgstr "Как используются мои персональные данные?"

msgid "Where can I read the store terms?"
msgstr "Где ознакомиться с правилами магазина?"

msgid "Store policy"
msgstr "Правила магазина"

msgid "Test a grounded policy answer"
msgstr "Проверить ответ по правилам магазина"

msgid "Uses one of the public policy pages approved in Store Knowledge."
msgstr "Использует одну из публичных страниц, утвержденных в Базе знаний."

msgid "Policy page: %s"
msgstr "Страница условий: %s"

msgid "Choose an available option for %s and add it to my cart"
msgstr "Выбери доступный вариант для %s и добавь в мою корзину"

msgid "Choose %1$s for %2$s and add it to my cart"
msgstr "Выбери %1$s для товара %2$s и положи в корзину"

msgid "Product index table"
msgstr "Таблица индекса товаров"

msgid "The product index table is present."
msgstr "Таблица товарного индекса создана и присутствует."

msgid "The product index table is missing, so Geeky Bot cannot search your catalog. Deactivating and reactivating the plugin rebuilds it."
msgstr "Таблица индекса отсутствует, поиск по каталогу невозможен. Деактивация и повторная активация плагина создадут ее заново."

msgid "The product search index is missing. Geeky Bot is falling back to slower matching with no relevance ranking. Reactivate the plugin to rebuild it."
msgstr "Поисковый индекс отсутствует. Поиск временно замедлен и работает без ранжирования. Переактивируйте плагин."

msgid "The product search index covers the wrong columns, so every search silently falls back to slower matching with no relevance ranking. Found: %1$s. Expected: %2$s. Reactivating the plugin repairs it."
msgstr "Индекс охватывает не те колонки, поэтому поиск работает медленно и без учета релевантности. Найдено: %1$s. Ожидалось: %2$s. Переактивация плагина исправит это."

msgid "The index looks correct but the last product search failed in the database and fell back to slower matching. Error: %s"
msgstr "Структура индекса в норме, но последний запрос к БД завершился сбоем и перешел в медленный режим. Ошибка: %s"

msgid "The product search index covers the expected columns."
msgstr "Поисковый индекс товаров охватывает все нужные колонки."

msgid "This store has no published products yet."
msgstr "В этом магазине пока нет опубликованных товаров."

msgid "None of your %d published products are indexed, so Geeky Bot cannot recommend anything. Rebuild the product index from the Geeky Bot settings."
msgstr "Ни один из %d опубликованных товаров не проиндексирован, рекомендации не работают. Перестройте индекс в настройках Geeky Bot."

msgid "Only %1$d of %2$d published products are indexed. Rebuild the product index so recommendations cover your whole catalog."
msgstr "В индексе только %1$d из %2$d товаров. Обновите индекс, чтобы рекомендации охватывали весь ассортимент."

msgid "%1$d of %2$d published products are indexed."
msgstr "Проиндексировано %1$d из %2$d опубликованных товаров."

msgid "Store vocabulary"
msgstr "Словарь магазина"

msgid "WooCommerce categories are unavailable, so only the built-in vocabulary is used."
msgstr "Категории WooCommerce недоступны, поэтому используется только встроенный базовый словарь."

msgid "No product categories have products in them, so Geeky Bot can only fall back to its built-in wording. Categorising your products teaches it the words your shoppers use."
msgstr "В категориях нет товаров, бот опирается лишь на стандартные фразы. Распределение товаров по категориям помогает ИИ выучить лексику покупателей."

msgid "Your product categories have not been read yet, so searches rely on built-in wording only. Rebuild the product index to learn them."
msgstr "Категории товаров еще не считаны, поиск использует только базовые термины. Обновите индекс товаров, чтобы бот их изучил."

msgid "%1$d product words learned from your %2$d categories."
msgstr "Изучено %1$d товарных терминов на основе %2$d категорий магазина."

msgid "Store policy answers"
msgstr "Ответы по правилам магазина"

msgid "No policy pages are selected, so Geeky Bot cannot answer questions about shipping, returns or refunds. Choose your policy pages in the Geeky Bot settings."
msgstr "Страницы условий не выбраны, бот не может отвечать о доставке и возвратах. Укажите их в настройках Geeky Bot."

msgid "Policy pages are selected but none are indexed, so policy questions fall back to \"please contact the store\". Re-sync your knowledge sources in the Geeky Bot settings."
msgstr "Страницы выбраны, но не проиндексированы, поэтому бот отвечает «обратитесь в магазин». Запустите синхронизацию в настройках."

msgid "%1$d of %2$d selected policy pages are indexed. Re-sync your knowledge sources so every page can be quoted."
msgstr "Проиндексировано %1$d из %2$d страниц правил. Синхронизируйте источники, чтобы бот мог цитировать каждую из них."

msgid "%d policy pages are indexed and available for answers."
msgstr "Проиндексировано и доступно для ответов страниц правил: %d."

msgid "Assistant visibility"
msgstr "Видимость ассистента"

msgid "The storefront assistant is switched off, so shoppers cannot see Geeky Bot."
msgstr "Ассистент на витрине выключен, покупатели его не видят."

msgid "WooCommerce is not active, so Geeky Bot cannot read your catalog."
msgstr "WooCommerce не активен, Geeky Bot не имеет доступа к каталогу."

msgid "The storefront assistant is enabled and WooCommerce is active."
msgstr "Ассистент на витрине включен, WooCommerce работает."

msgid "Geeky Bot search health"
msgstr "Состояние поиска Geeky Bot"

msgid "Geeky Bot search is healthy"
msgstr "Поиск Geeky Bot работает отлично"

msgid "The product index, search index and policy sources are all working."
msgstr "Товарный индекс, поисковый индекс и страницы правил функционируют без нареканий."

msgid "Geeky Bot search needs attention"
msgstr "Поиск Geeky Bot требует внимания"

msgid "Geeky Bot search is degraded"
msgstr "Поиск Geeky Bot работает с ограничениями"

msgid "Geeky Bot is answering from a degraded state."
msgstr "Geeky Bot работает в аварийном замедленном режиме."

msgid "The page is not an approved knowledge source."
msgstr "Эта страница не одобрена как источник базы знаний."

msgid "The selected page is not public."
msgstr "Выбранная страница не является общедоступной."

msgid "The selected page has no readable public text."
msgstr "На выбранной странице нет текста, доступного для чтения."

msgid "The policy page could not be indexed."
msgstr "Не удалось проиндексировать страницу правил."

msgid "According to the store’s “%1$s” page: %2$s"
msgstr "Согласно странице магазина «%1$s»: %2$s"

msgid "store policy"
msgstr "правила магазина"

msgid "I couldn't find this information in the store’s published %s pages. Please contact the store for confirmation."
msgstr "Я не нашел этого в правилах магазина о «%s». Обратитесь к сотрудникам для подтверждения."

msgid "I couldn't find that detail in the store’s published %s information. Please review the page below or contact the store for confirmation."
msgstr "В опубликованных условиях о «%s» нет этой детали. Ознакомьтесь со страницей ниже или свяжитесь с магазином."

msgid "Commerce Pro license storage requires the PHP OpenSSL or Sodium extension. Commerce Pro remains locked until secure local storage is available and the license is refreshed."
msgstr "Для сохранения лицензии Commerce Pro требуются модули OpenSSL или Sodium в PHP. Дополнение будет заблокировано, пока не появится поддержка шифрования."

msgid "Commerce Pro needs a fresh license verification before it can run on this site."
msgstr "Commerce Pro требует повторной проверки лицензии для запуска на этом домене."

msgid "Your Commerce Pro license has expired. Buying actions continue on this activated site, but updates, protected downloads, support, and new activations require renewal."
msgstr "Срок действия лицензии Commerce Pro истек. Покупки работают, но обновления, скачивание пакетов и техподдержка требуют продления."

msgid "Your Commerce Pro subscription is cancelled but remains active until the paid period ends. Renew to keep updates, downloads, and support active after expiry."
msgstr "Подписка Commerce Pro отменена, но действует до конца оплаченного срока. Продлите ее, чтобы не потерять обновления и поддержку."

msgid "Could not refresh the Commerce Pro license recently. Commerce Pro is running on cached verification until the grace period expires."
msgstr "Не удалось обновить статус лицензии Commerce Pro. Плагин работает на основе кэша до окончания льготного периода."

msgid "Staging limit reached"
msgstr "Достигнут лимит тестовых сайтов"

msgid "Production limit reached"
msgstr "Достигнут лимит рабочих сайтов"

msgid "This server cannot securely store the Commerce Pro license key. Enable the PHP OpenSSL or Sodium extension, then try again."
msgstr "Сервер не может безопасно сохранить лицензионный ключ. Включите PHP-расширение OpenSSL или Sodium и попробуйте снова."

msgid "Please enter a license key."
msgstr "Пожалуйста, введите лицензионный ключ."

msgid "No Commerce Pro license key is saved yet."
msgstr "Ключ лицензии Commerce Pro еще не сохранен."

msgid "License deactivated on this site."
msgstr "Лицензия на этом сайте деактивирована."

msgid "A valid Commerce Pro license with download access is required before installing the add-on."
msgstr "Для установки дополнения требуется действующая лицензия с правом на загрузку."

msgid "The license server did not return a safe Commerce Pro package URL."
msgstr "Сервер лицензий не вернул безопасный URL-адрес для загрузки Commerce Pro."

msgid "Commerce Pro could not be installed."
msgstr "Не удалось установить Commerce Pro."

msgid "Activate a valid Commerce Pro license before activating the add-on."
msgstr "Активируйте действующую лицензию Commerce Pro перед включением дополнения."

msgid "You do not have permission to update plugins."
msgstr "У вас недостаточно прав для обновления плагинов."

msgid "Your Commerce Pro license must include update access before updating the add-on."
msgstr "Лицензия Commerce Pro должна включать право на обновления для загрузки новой версии."

msgid "Commerce Pro is already on the latest available version."
msgstr "Commerce Pro уже обновлен до актуальной версии."

msgid "The license server did not return a valid Commerce Pro update package."
msgstr "Сервер лицензий не вернул корректный пакет обновления Commerce Pro."

msgid "Commerce Pro could not be updated."
msgstr "Не удалось обновить Commerce Pro."

msgid "The Commerce Pro update package could not be downloaded."
msgstr "Не удалось загрузить пакет обновления Commerce Pro."

msgid "The Commerce Pro update package is empty or incomplete."
msgstr "Пакет обновления Commerce Pro пуст или поврежден."

msgid "The Commerce Pro update package is invalid. Please try again or contact Geeky Bot support."
msgstr "Пакет обновления Commerce Pro некорректен. Повторите попытку или обратитесь в поддержку Geeky Bot."

msgid "The downloaded Commerce Pro package is not a valid ZIP archive."
msgstr "Загруженный пакет Commerce Pro не является допустимым ZIP-архивом."

msgid "The downloaded Commerce Pro package did not match the release checksum."
msgstr "Загруженный пакет Commerce Pro не совпадает с контрольной суммой релиза."

msgid "Important Commerce Pro security update %1$s is available. Installed version: %2$s."
msgstr "Доступно важное обновление безопасности Commerce Pro: %1$s. Установлена версия: %2$s."

msgid "Commerce Pro %1$s is available. Installed version: %2$s."
msgstr "Доступна версия Commerce Pro %1$s. Установлена версия: %2$s."

msgid "Review license"
msgstr "Проверить лицензию"

msgid "Open Add-ons"
msgstr "Открыть дополнения"

msgid "CDN release metadata was too large."
msgstr "Метаданные релиза с CDN превысили допустимый размер."

msgid "CDN release metadata was not readable."
msgstr "Не удалось прочитать метаданные релиза с CDN."

msgid "CDN release metadata was for a different product."
msgstr "Метаданные релиза с CDN относятся к другому продукту."

msgid "The requested license action is not allowed."
msgstr "Запрошенное действие с лицензией не разрешено."

msgid "The license server response was too large."
msgstr "Ответ сервера лицензий слишком велик."

msgid "The license server returned an invalid response."
msgstr "Сервер лицензий вернул некорректный ответ."

msgid "The license server rejected the request."
msgstr "Сервер лицензий отклонил запрос."

msgid "Staging activation limit reached. This license already uses all included staging-site activations. Commerce Pro was not authorized for this site and cannot be installed or enabled from Geeky Bot. Deactivate an unused staging site at geekybot.com or contact support for another staging activation."
msgstr "Лимит тестовых сайтов исчерпан. Все слоты для staging-сайтов заняты. Commerce Pro не авторизован для этого домена. Отключите ненужный сайт на geekybot.com или обратитесь в поддержку."

msgid "Production activation limit reached. This license already uses all included production-site activations. Commerce Pro was not authorized for this site and cannot be installed or enabled from Geeky Bot. Deactivate an unused production site at geekybot.com or upgrade the license."
msgstr "Лимит рабочих сайтов исчерпан. Все production-слоты заняты. Commerce Pro не может работать на этом домене. Освободите слот на geekybot.com или обновите тариф лицензии."

msgid "License active."
msgstr "Лицензия активна."

msgid "Commerce Pro was not authorized for this site. Review the license status and try again."
msgstr "Commerce Pro не авторизован для этого сайта. Проверьте статус лицензии и попробуйте снова."

msgid "The license server response could not be verified."
msgstr "Не удалось проверить ответ сервера лицензий."

msgid "This server cannot verify the Commerce Pro entitlement signature. Enable the PHP OpenSSL extension."
msgstr "Сервер не может проверить цифровую подпись Commerce Pro. Включите расширение OpenSSL в PHP."

msgid "The Commerce Pro entitlement signature is invalid."
msgstr "Цифровая подпись лицензии Commerce Pro недействительна."

msgid "The Commerce Pro entitlement claims are invalid."
msgstr "Параметры лицензии Commerce Pro некорректны."

msgid "This Commerce Pro entitlement belongs to a different site."
msgstr "Эта лицензия Commerce Pro привязана к другому сайту."

msgid "The Commerce Pro entitlement response is incomplete."
msgstr "Ответ сервера лицензий Commerce Pro неполон."

msgid "The Commerce Pro entitlement response is stale. Please refresh the license."
msgstr "Данные лицензии Commerce Pro устарели. Пожалуйста, обновите лицензию."

msgid "The Commerce Pro entitlement response does not match this request."
msgstr "Ответ лицензии Commerce Pro не соответствует отправленному запросу."

msgid "The Commerce Pro entitlement response has expired. Please refresh the license."
msgstr "Срок действия ответа лицензии истек. Пожалуйста, обновите лицензию."

